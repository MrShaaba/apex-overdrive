{
  "name": "apex-overdrive",
  "private": true,
  "version": "1.0.0",
  "description": "Apex Overdrive — a browser-native premium 3D racing game built with Three.js, Rapier and React.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "node tests/collider-audit.mjs && node tests/wheel-calibration.mjs && node tests/split-screen.mjs",
    "preview": "vite preview --host",
    "assets:manifest": "node tools/asset-pipeline/build-manifest.mjs",
    "assets:photos": "node tools/asset-pipeline/prepare-photos.mjs",
    "assets:validate": "node tools/asset-pipeline/validate.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@gltf-transform/cli": "^4.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "basisu": "^1.16.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "patch-package": "^8.0.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
